# Copy to .env (git-ignored). These values stay on the server; never put them in the app.

# Control-plane API key (dashboard > Developers > API keys). Scopes used: links:write, links:read,
# analytics:read, conversions:write.
CLIKGATE_API_KEY=cg_test_replace_me
# Local backend: http://localhost:8000
CLIKGATE_API_URL=https://api.clikgate.com
# The app's identity secret (POST /v1/apps/{app_id}/identity-secret/rotate). Signs identity tokens.
CLIKGATE_IDENTITY_SECRET=replace_me
# Referral program the app shows links and stats for.
CLIKGATE_PROGRAM_ID=rpg_replace_me
# Leaderboards the app may read through this backend (comma-separated; empty = any).
CLIKGATE_LEADERBOARD_IDS=lb_replace_me
# App for server-side events (POST /orders). Per-platform ids win when the order sends `platform`.
CLIKGATE_APP_ID=app_replace_me
# CLIKGATE_APP_ID_ANDROID=
# CLIKGATE_APP_ID_IOS=
# Signs this sample's demo session tokens (random per process when unset).
SESSION_SECRET=replace_me_with_a_long_random_string
# SESSION_TTL_SECONDS=604800
