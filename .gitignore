# Build output and local machine files across the SDKs
build/
.gradle/
local.properties
.idea/
*.iml
.DS_Store
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
Pods/
DerivedData/
.build/
.swiftpm/*
# ios/.swiftpm/xcode/xcshareddata/xcschemes/Clikgate-Package.xcscheme is kept (see ios/.gitignore)
!/ios/.swiftpm/
xcuserdata/
node_modules/
*.xcframework
*.xcframework.zip

# cli/ (setup command, @clikgate/setup)
cli/dist/
cli/*.tgz
.clikgate-setup-backup/

# Internal build material lives in the private clikgate-sdk-internal repository, never here
# (scripts/check_public_repo.py fails the build if it comes back)
docs/spec/
DECISIONS.md
PROGRESS.md
__pycache__/
*.pyc
