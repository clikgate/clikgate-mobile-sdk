{
  "compilerOptions": {
    "target": "ES2019",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2019"],
    "rootDir": "src",
    "outDir": "build",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__"]
}
