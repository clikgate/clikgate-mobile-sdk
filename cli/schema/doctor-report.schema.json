{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clikgate.com/schemas/setup-doctor-report-1.json",
  "title": "Clikgate setup doctor report",
  "description": "Output of `npx @clikgate/setup doctor --json`. schema_version 1; new optional fields may be added without a version change.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "cli_version",
    "project",
    "ok",
    "summary",
    "checks",
    "next_steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "doctor"
    },
    "cli_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "path",
        "platform"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path of the project folder"
        },
        "platform": {
          "enum": [
            "flutter",
            "react-native",
            "expo",
            "android",
            "ios",
            null
          ]
        }
      }
    },
    "ok": {
      "type": "boolean",
      "description": "true when no check failed (warnings allowed); the exit code is 0 when ok, else 1"
    },
    "summary": {
      "type": "object",
      "required": [
        "passed",
        "warnings",
        "failed",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "status",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[A-Za-z0-9_.-]+)+$"
          },
          "group": {
            "enum": [
              "project",
              "clikgate",
              "live"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "skip"
            ]
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "doc_url": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable problem code from Clikgate's setup check (e.g. not_listed_on_shared_domain)"
          }
        },
        "additionalProperties": false
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message",
          "doc_url"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "doc_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
