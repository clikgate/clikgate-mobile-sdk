@@ -5,4 +5,7 @@
 
 import UIKit
+// clikgate-setup:start
+import Clikgate
+// clikgate-setup:end
 
 @main
@@ -12,4 +15,17 @@
 
     func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
+        // clikgate-setup:start
+        // acme.dev.ciz.to (test links) only in Debug builds
+        #if DEBUG
+        let linkDomains = ["acme.ciz.to", "go.acme.com", "acme.dev.ciz.to"]
+        #else
+        let linkDomains = ["acme.ciz.to", "go.acme.com"]
+        #endif
+        Clikgate.configure(sdkKey: "cg_sdk_test_abc123", options: ClikgateOptions(linkDomains: linkDomains))
+        Clikgate.shared.onDeepLink { link in
+            // Open the screen for link.path (link.data has the link's data)
+            print("Clikgate deep link:", link.path ?? "/")
+        }
+        // clikgate-setup:end
         // Override point for customization after application launch.
         return true

--- a/UIKitApp/SceneDelegate.swift
