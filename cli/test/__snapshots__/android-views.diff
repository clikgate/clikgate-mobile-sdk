@@ -0,0 +1,28 @@
+package com.example.viewsapp
+
+import android.app.Application
+import android.content.pm.ApplicationInfo
+import android.util.Log
+import com.clikgate.Clikgate
+import com.clikgate.ClikgateOptions
+
+// Created by the Clikgate setup command (registered in AndroidManifest.xml).
+class ClikgateApplication : Application() {
+    override fun onCreate() {
+        super.onCreate()
+        // clikgate-setup:start
+        // acme.dev.ciz.to (test links) only in debug builds
+        val debuggable = (applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE) != 0
+        val linkDomains = if (debuggable) listOf("acme.ciz.to", "go.acme.com") + "acme.dev.ciz.to" else listOf("acme.ciz.to", "go.acme.com")
+        Clikgate.configure(
+            this,
+            sdkKey = "cg_sdk_test_abc123",
+            options = ClikgateOptions(linkDomains = linkDomains),
+        )
+        Clikgate.onDeepLink { link ->
+            // Open the screen for link.path (link.data has the link's data)
+            Log.i("Clikgate", "Deep link: ${link.path}")
+        }
+        // clikgate-setup:end
+    }
+}

