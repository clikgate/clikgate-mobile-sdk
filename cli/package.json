{
  "name": "@clikgate/setup",
  "version": "1.1.1",
  "description": "Set up Clikgate (deep links, attribution, goals) in a Flutter, React Native, Expo, Android or iOS app project with one command. Shows every change and asks before writing anything.",
  "keywords": [
    "clikgate",
    "deep-linking",
    "app-links",
    "universal-links",
    "flutter",
    "react-native",
    "expo",
    "android",
    "ios",
    "setup"
  ],
  "homepage": "https://clikgate.com/docs/setup-command",
  "bugs": {
    "url": "https://github.com/clikgate/clikgate-mobile-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clikgate/clikgate-mobile-sdk.git",
    "directory": "cli"
  },
  "license": "MIT",
  "author": "Clikgate <sdk@clikgate.com> (https://clikgate.com)",
  "bin": {
    "clikgate-setup": "dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs",
    "schema/doctor-report.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "check:sdk-versions": "node ../scripts/check_cli_sdk_versions.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@bacons/xcode": "1.0.0-alpha.33",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "plist": "5.0.0",
    "saxes": "6.0.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@xmldom/xmldom@<0.8.15": "0.8.15"
  }
}
