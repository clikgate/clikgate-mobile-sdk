{
  "name": "@clikgate/react-native-engage",
  "version": "2.0.0",
  "description": "Clikgate Engage add-on for React Native: referral links and stats, share helpers, leaderboards and promo codes for apps without their own backend. TypeScript over @clikgate/react-native, plus the native Engage share menu.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "clikgate-react-native-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "CHANGELOG.md",
    "!ios/build",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "scripts": {
    "devlink": "node scripts/devlink.js",
    "build": "bob build",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "referrals",
    "leaderboards",
    "clikgate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clikgate/clikgate-mobile-sdk.git",
    "directory": "react-native-engage"
  },
  "author": "Clikgate <sdk@clikgate.com> (https://clikgate.com)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/clikgate/clikgate-mobile-sdk/issues"
  },
  "homepage": "https://clikgate.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@clikgate/react-native": "^2.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 20.19.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__}/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "codegenConfig": {
    "name": "RNClikgateEngageSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.clikgate.reactnative.engage"
    },
    "ios": {
      "modulesProvider": {
        "ClikgateEngage": "RNClikgateEngage"
      }
    }
  }
}
