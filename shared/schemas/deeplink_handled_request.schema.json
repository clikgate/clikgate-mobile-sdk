{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.clikgate.com/schemas/deeplink_handled_request.schema.json",
  "title": "deeplink_handled_request",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^?#]*$"
    },
    "is_deferred": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "path",
    "is_deferred"
  ]
}
