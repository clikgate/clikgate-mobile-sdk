{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.clikgate.com/schemas/resolve_request.schema.json",
  "title": "resolve_request",
  "type": "object",
  "properties": {
    "url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "click_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "consent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tracking_allowed": {
              "type": "boolean"
            },
            "analytics": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "attribution": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "ad_user_data": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "ad_personalization": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "region": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(EEA|UK|[A-Z]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "google_click_ids": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "gclid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "gbraid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "wbraid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "enum": [
                "deep_link",
                "install_referrer"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
