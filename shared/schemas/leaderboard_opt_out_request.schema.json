{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.clikgate.com/schemas/leaderboard_opt_out_request.schema.json",
  "title": "leaderboard_opt_out_request",
  "type": "object",
  "properties": {
    "program_id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "opt_out": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "program_id",
    "opt_out"
  ]
}
