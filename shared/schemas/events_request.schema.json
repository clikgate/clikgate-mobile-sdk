{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.clikgate.com/schemas/events_request.schema.json",
  "title": "events_request",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.$:-]{1,64}$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "revenue_minor": {
            "type": [
              "integer",
              "null"
            ]
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "properties": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "event_id",
          "name",
          "occurred_at"
        ]
      }
    },
    "consent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tracking_allowed": {
              "type": "boolean"
            },
            "analytics": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "attribution": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "ad_user_data": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "ad_personalization": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "region": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(EEA|UK|[A-Z]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "events"
  ]
}
