{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.clikgate.com/schemas/open_request.schema.json",
  "title": "open_request",
  "type": "object",
  "properties": {
    "app_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "os_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_cold_start": {
      "type": "boolean"
    },
    "push": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "apns",
                "fcm"
              ]
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "apns_environment": {
              "enum": [
                "production",
                "sandbox",
                null
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "token"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "consent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tracking_allowed": {
              "type": "boolean"
            },
            "analytics": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "attribution": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "ad_user_data": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "ad_personalization": {
              "enum": [
                "granted",
                "denied",
                "unknown"
              ]
            },
            "region": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(EEA|UK|[A-Z]{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "google_click_ids": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "gclid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "gbraid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "wbraid": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "enum": [
                "deep_link",
                "install_referrer"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "app_instance_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "required": [
    "is_cold_start"
  ]
}
