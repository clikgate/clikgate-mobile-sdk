{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.clikgate.com/schemas/app_record_request.schema.json",
  "title": "app_record_request",
  "type": "object",
  "properties": {
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "signed_record": {
      "type": "string",
      "minLength": 20,
      "maxLength": 65536
    }
  },
  "additionalProperties": false,
  "required": [
    "installation_id",
    "signed_record"
  ]
}
