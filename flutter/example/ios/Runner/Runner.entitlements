<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links on the Clikgate link domain (the domain serves the AASA file). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(CLIKGATE_LINK_DOMAIN)</string>
	</array>
	<!-- Push (uninstall checks). Xcode switches this to production for distribution builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
