# What `dart pub publish` leaves out. This file replaces flutter/.gitignore for pub, so its
# entries are repeated here.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
/coverage/
.gradle/
local.properties
Pods/
xcuserdata/

# Repository-only files: design notes, tests, tooling. The full example app lives in the
# repository; the package ships example/example.md only.
DECISIONS.md
**/test/
**/tool/
**/example/*
!**/example/example.md
